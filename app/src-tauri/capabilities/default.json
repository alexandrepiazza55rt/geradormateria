{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissões padrão do app (diálogos nativos, SQLite do usuário e atualização de base por HTTPS).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "sql:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://github.com/*" },
        { "url": "https://*.githubusercontent.com/*" },
        { "url": "https://objects.githubusercontent.com/*" },
        { "url": "https://gerador-licenca.alexandresigma.workers.dev/*" },
        { "url": "https://*.workers.dev/*" },
        { "url": "http://localhost:*/*" },
        { "url": "http://127.0.0.1:*/*" }
      ]
    }
  ]
}
